# Copy to .env.local for development. Never commit real values.
# Public values used by the static site (safe to expose; access is enforced by RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets live in Supabase Edge Function secrets, never in this repo or the site:
#   SUPABASE_SERVICE_ROLE_KEY
#   SEED_ENCRYPTION_KEY   (32-byte hex, spec 6.2: openssl rand -hex 32)
